---
import { PENDING, siteConfig } from '../../config/site';

const navigationLinks = [
	{ href: '/#inicio', label: 'Inicio' },
	{ href: '/#servicios', label: 'Servicios' },
	{ href: '/#contacto', label: 'Contacto' },
];
---

<footer class="site-footer">
	<div class="site-container site-footer__inner">
		<div class="site-footer__identity">
			<p class="site-footer__brand">{siteConfig.commercialName}</p>
			{siteConfig.commercialEmail !== PENDING && <p class="mt-2 mb-0">Correo: {siteConfig.commercialEmail}</p>}
			{siteConfig.whatsappBusinessNumber !== PENDING && <p class="mt-1 mb-0">WhatsApp: {siteConfig.whatsappBusinessNumber}</p>}
			<p class="mt-3 mb-0">&copy; {new Date().getFullYear()} {siteConfig.commercialName}.</p>
		</div>
		<div class="site-footer__links">
			<nav aria-label="Enlaces de navegación">
				{navigationLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
			<nav aria-label="Enlaces legales">
				<a href="/politica-de-privacidad">Privacidad</a>
				<a href="/terminos-y-condiciones">Términos</a>
			</nav>
		</div>
	</div>
</footer>
