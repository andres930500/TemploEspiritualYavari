---
import { siteConfig } from '../../config/site';
---

<header class="border-b border-gold/20 bg-ink/95 backdrop-blur-sm">
	<div class="site-container flex min-h-18 items-center justify-between gap-4">
		<a class="site-header__brand" href="/" aria-label={`Ir al inicio de ${siteConfig.commercialName}`}>
			<span class="site-header__mark" aria-hidden="true">✦</span>
			<span class="site-header__brand-copy">
				<strong>AMARRES DE AMOR</strong>
				<span>CONSULTA ESPIRITUAL · SERIEDAD · TRANSPARENCIA</span>
			</span>
		</a>
	</div>
</header>
