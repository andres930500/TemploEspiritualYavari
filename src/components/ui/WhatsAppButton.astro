---
import { siteConfig } from '../../config/site';
import { services } from '../../data/services';
import { createWhatsAppUrl } from '../../lib/whatsapp';

interface Props {
	serviceId?: string;
	label?: string;
	location?: string;
	section?: string;
	variant?: 'primary' | 'secondary';
	size?: 'small' | 'medium' | 'large';
	className?: string;
	message?: string;
	showIcon?: boolean;
}

const {
	serviceId,
	label = 'Contactar por WhatsApp',
	location = 'inline',
	section = 'general',
	variant = 'primary',
	size = 'medium',
	className = '',
	message,
	showIcon = false,
} = Astro.props;
const service = serviceId ? services.find((item) => item.id === serviceId) : undefined;
const contactMessage = message ?? service?.whatsappMessage ?? 'Hola, encontré su página web y deseo recibir información sobre sus servicios.';
const whatsappUrl = createWhatsAppUrl(siteConfig.whatsappBusinessNumber, contactMessage);
const classes = `button button--${variant} button--${size} whatsapp-button ${className}`.trim();
---

{whatsappUrl ? (
	<a
		class={classes}
		href={whatsappUrl}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={label}
		data-whatsapp-link
		data-service={serviceId ?? 'general'}
		data-placement={location}
		data-section={section}
		data-service-interest={serviceId ? 'true' : 'false'}
	>
		{showIcon && <span class="whatsapp-button__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.52 0 .19 5.33.19 11.89c0 2.1.55 4.15 1.6 5.96L.08 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.88-5.33 11.88-11.89 0-3.18-1.23-6.17-3.44-8.43Zm-8.45 18.28h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.23-.37a9.87 9.87 0 1 1 8.37 4.63Zm5.42-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.7.64.71.23 1.35.2 1.86.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path></svg></span>}
		{label}
	</a>
) : (
	<button class={`${classes} button--disabled`} type="button" disabled aria-disabled="true" title="Configura un número válido en src/config/site.ts">
		{showIcon && <span class="whatsapp-button__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.07 0C5.52 0 .19 5.33.19 11.89c0 2.1.55 4.15 1.6 5.96L.08 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.88-5.33 11.88-11.89 0-3.18-1.23-6.17-3.44-8.43Zm-8.45 18.28h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.23-.37a9.87 9.87 0 1 1 8.37 4.63Zm5.42-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.74-1.64-2.04-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.7.64.71.23 1.35.2 1.86.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path></svg></span>}
		{label}
	</button>
)}
