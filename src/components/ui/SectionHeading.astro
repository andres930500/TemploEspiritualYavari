---
interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
	{eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
	<h2 class="section-heading__title" id={id}>{title}</h2>
	{description && <p class="section-heading__description">{description}</p>}
</div>
