---
interface Props {
	label: string;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	variant?: 'primary' | 'secondary';
}

const { label, href, type = 'button', variant = 'primary' } = Astro.props;
const className = `button button--${variant}`;
---

{href ? <a class={className} href={href}>{label}</a> : <button class={className} type={type}>{label}</button>}
