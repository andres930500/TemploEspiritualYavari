---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	width: number;
	height: number;
	sizes?: string;
	class?: string;
	loading?: 'eager' | 'lazy';
	priority?: boolean;
}

const { src, alt, width, height, sizes, class: className, loading = 'lazy', priority = false } = Astro.props;
---

<Image
	src={src}
	alt={alt}
	width={width}
	height={height}
	sizes={sizes}
	class={className}
	loading={priority ? 'eager' : loading}
	fetchpriority={priority ? 'high' : undefined}
	decoding="async"
/>
