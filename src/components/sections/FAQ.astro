---
import { faqItems } from '../../data/faq';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section section--light" id="preguntas" aria-labelledby="faq-title">
	<div class="site-container">
		<SectionHeading id="faq-title" eyebrow="Respuestas provisionales" title="Preguntas frecuentes" description="Estas respuestas se actualizarán con la información comercial definitiva." />
		<div class="max-w-3xl">
			{faqItems.filter((item) => item.active).sort((a, b) => a.order - b.order).map((item) => (
				<details class="faq-item" data-faq-id={item.id}>
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
