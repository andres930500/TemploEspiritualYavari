---
import ServicioCard from '../servicios/ServicioCard.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import servicesContent from '../../data/servicios-contenido.json';
---

<section class="yavari-services" id="servicios" aria-labelledby="services-title">
	<div class="yavari-services__background" aria-hidden="true"></div>
	<div class="yavari-services__content">
		<header class="yavari-services__header">
			<img src="/assets/servicios/ornamentos/loto-ornamental.svg" alt="" width="72" height="54" />
			<h2 id="services-title">NUESTROS<br /><strong>SERVICIOS</strong></h2>
			<p class="yavari-services__eyebrow">RITUALES · ORIENTACIÓN · PROTECCIÓN</p>
			<img class="yavari-services__divider" src="/assets/servicios/ornamentos/divisor-luna.svg" alt="" width="170" height="24" />
			<p class="yavari-services__intro">Cada situación tiene un camino espiritual.<br />Descubre cómo podemos acompañarte.</p>
		</header>

		<div class="yavari-services__grid">
			{servicesContent.map((service, index) => <ServicioCard service={service} index={index} />)}
		</div>

		<footer class="yavari-services__footer">
			<img src="/assets/servicios/ornamentos/divisor-luna.svg" alt="" width="170" height="24" />
			<h2>TU HISTORIA MERECE SER ESCUCHADA</h2>
			<p>Cuéntanos tu situación y conoce las opciones de orientación espiritual.</p>
			<WhatsAppButton label="HABLAR POR WHATSAPP" message="Hola, encontré su página web y deseo recibir información sobre sus servicios de orientación espiritual." section="services" location="services-footer" size="large" showIcon />
			<p class="yavari-services__footer-note">Atención personalizada · Consulta sin compromiso</p>
		</footer>
	</div>
</section>
