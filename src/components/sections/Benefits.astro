---
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section section--light" id="beneficios" aria-labelledby="benefits-title">
	<div class="site-container">
		<SectionHeading id="benefits-title" eyebrow="Características" title="Información clara para tu decisión" description="Conoce el servicio, resuelve tus preguntas y decide con tranquilidad." />
		<div class="card-grid md:grid-cols-3">
			{[
				['Información previa', 'Conoce el servicio disponible antes de solicitar una consulta.'],
				['Atención directa', 'Resuelve tus preguntas mediante el canal de contacto configurado.'],
				['Decisión informada', 'Recibe información y decide libremente si deseas continuar.'],
			].map(([title, description]) => (
				<article class="rounded-card border border-charcoal/10 bg-paper p-6 shadow-card">
					<h3 class="m-0 text-lg font-bold text-text-dark">{title}</h3>
					<p class="mt-3 leading-relaxed text-text-dark">{description}</p>
				</article>
			))}
		</div>
	</div>
</section>
