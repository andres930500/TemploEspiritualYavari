# Variables públicas y no sensibles para el entorno de Astro.
# Copia este archivo como .env.local para desarrollo.
PUBLIC_SITE_URL=PENDIENTE_DE_CONFIGURAR
PUBLIC_SITE_ENV=development
PUBLIC_ALLOW_INDEXING=false
PUBLIC_GOOGLE_TAG_MANAGER_ID=PENDIENTE_DE_CONFIGURAR
PUBLIC_GTM_CONSENT_GRANTED=false
PUBLIC_ANALYTICS_ID=PENDIENTE_DE_CONFIGURAR

# Nunca agregues aquí contraseñas, tokens privados o claves secretas.
